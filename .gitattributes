# Normalize line endings to LF in the repository and on checkout.
# This keeps the working tree identical on Windows, Linux and CI, and is what
# the Biome formatter expects (formatter.lineEnding defaults to "lf").
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.pdf binary
