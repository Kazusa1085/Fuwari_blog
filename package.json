{
	"name": "fuwari",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"build:indexnow": "astro build && node scripts/submit-indexnow-incremental.mjs",
		"submit-indexnow": "node scripts/submit-indexnow.mjs",
		"submit-indexnow-inc": "node scripts/submit-indexnow-incremental.mjs",
		"submit-indexnow-force": "node scripts/submit-indexnow-incremental.mjs --force",
		"indexnow-status": "node scripts/submit-indexnow-incremental.mjs --status",
		"indexnow-clear": "node scripts/submit-indexnow-incremental.mjs --clear",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "tsc --noEmit",
		"new-post": "node scripts/new-post.js",
		"format": "biome format --write ./src",
		"lint": "biome check --write ./src",
		"update-timestamp": "node scripts/update-post-timestamp.mjs",
		"sync-content": "node scripts/sync-content.js",
		"clean:astro": "node scripts/clean-astro-cache.js",
		"predev": "node scripts/sync-content.js || true",
		"prebuild": "node scripts/clean-astro-cache.js && node scripts/sync-content.js",
		"prepare": "node -e \"const fs=require('fs');const src='scripts/pre-commit';const dst='.git/hooks/pre-commit';if(fs.existsSync(src)&&fs.existsSync('.git')){fs.mkdirSync('.git/hooks',{recursive:true});fs.copyFileSync(src,dst);console.log('Git hook installed!')}\""
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/markdown-remark": "^7.3.0",
		"@astrojs/react": "^6.0.5",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/svelte": "^9.0.1",
		"@expressive-code/core": "^0.44.2",
		"@expressive-code/plugin-collapsible-sections": "^0.44.2",
		"@expressive-code/plugin-line-numbers": "^0.44.2",
		"@fancyapps/ui": "^6.1.15",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/roboto": "^5.3.0",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.91",
		"@iconify-json/simple-icons": "^1.2.95",
		"@iconify/svelte": "^5.2.2",
		"@react-three/fiber": "^9.7.0",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@types/three": "^0.185.4",
		"@vercel/functions": "^3.9.5",
		"astro": "^7.3.1",
		"astro-expressive-code": "^0.44.2",
		"astro-icon": "^1.2.0",
		"hastscript": "^9.0.1",
		"katex": "^0.18.7",
		"markdown-it": "^15.0.1",
		"mdast-util-to-string": "^4.0.0",
		"node-html-parser": "^9.0.4",
		"overlayscrollbars": "^2.16.0",
		"photoswipe": "^5.4.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^4.0.0",
		"remark-directive-rehype": "^1.0.0",
		"remark-github-admonitions-to-directives": "^2.1.0",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.17.7",
		"sharp": "^0.35.4",
		"sql.js": "^1.14.2",
		"stylus": "^0.64.0",
		"svelte": "^5.57.0",
		"tailwindcss": "^4.3.3",
		"three": "^0.185.1",
		"typescript": "^6.0.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.11",
		"@biomejs/biome": "2.5.12",
		"@rollup/plugin-yaml": "^5.0.0",
		"@types/hast": "^3.0.5",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/sanitize-html": "^2.16.1",
		"postcss-import": "^17.0.0",
		"rehype": "^13.0.2"
	},
	"packageManager": "pnpm@9.15.9"
}
