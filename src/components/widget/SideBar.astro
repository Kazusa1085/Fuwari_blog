---
import type { MarkdownHeading } from "astro";
import type { RelatedPostItem } from "@/types/widgets";

import Profile from "./Profile.astro";
import RelatedPosts from "./RelatedPosts.astro";
import VisitorInfo from "./VisitorInfo.astro";
import MusicSidebarWidget from "./music-sidebar/MusicSidebarWidget.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	relatedPosts?: RelatedPostItem[];
}

const className = Astro.props.class;
const relatedPosts = Astro.props.relatedPosts ?? [];
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        
    <VisitorInfo class="onload-animation" style="animation-delay: 200ms"></VisitorInfo>

    <RelatedPosts posts={relatedPosts} class="onload-animation" style="animation-delay: 250ms" />

    <MusicSidebarWidget class="onload-animation" style="animation-delay: 300ms" />

    </div>
</div>

