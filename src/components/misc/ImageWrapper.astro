---
import path from "node:path";
interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	fit?: "cover" | "contain"; // how image should fit its container
	dim?: boolean; // whether to render the dim overlay layer
	isLCP?: boolean; // whether this is the Largest Contentful Paint image
	fetchPriority?: "high" | "low" | "auto"; // fetch priority hint for the browser
}
import { Image } from "astro:assets";
import { imageFallbackConfig, siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	fit = "cover",
	dim = true,
	isLCP = false,
	fetchPriority,
} = Astro.props;
// 当 isLCP 为 true 且未显式指定 fetchPriority 时，自动设为 "high"
const effectiveFetchPriority = fetchPriority ?? (isLCP ? "high" : undefined);
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{jpeg,jpg,png,gif,webp,avif}",
		{
			import: "default",
		},
	);
	// Covers can live in the external content repo (top-level content/), which
	// is outside src/. Vite can still glob them from the project root.
	const contentFiles = import.meta.glob<ImageMetadata>(
		"/content/**/*.{jpeg,jpg,png,gif,webp,avif}",
		{
			import: "default",
		},
	);
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	let file = files[normalizedPath];
	if (!file && basePath.startsWith("content/")) {
		const contentKey = "/" + path.posix.join(basePath, src).replace(/^\/+/, "");
		file = contentFiles[contentKey];
	}
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const imageClass = `w-full h-full object-${fit}`;
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative image-wrapper']} style={`--theme-hue: ${siteConfig.themeColor.hue}`}>
    <!-- 图片内容 -->
    {dim && <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>}
    
    {isLocal && img && <Image src={img} alt={alt || ""} class={`${imageClass} image-content`} style={imageStyle} loading={isLCP ? "eager" : "lazy"} fetchpriority={effectiveFetchPriority} />}
    
    {!isLocal && (
        imageFallbackConfig.enable && src.includes(imageFallbackConfig.originalDomain) ? 
            <img src={isPublic ? url(src) : src} alt={alt || ""} class={`${imageClass} image-content`} style={imageStyle} onerror={`this.onerror=null; this.src='${(isPublic ? url(src) : src).replace(imageFallbackConfig.originalDomain, imageFallbackConfig.fallbackDomain)}';`} loading={isLCP ? "eager" : "lazy"} fetchpriority={effectiveFetchPriority} /> :
            <img src={isPublic ? url(src) : src} alt={alt || ""} class={`${imageClass} image-content`} style={imageStyle} loading={isLCP ? "eager" : "lazy"} fetchpriority={effectiveFetchPriority} />
    )}
</div>

<style>
    
    .image-wrapper:hover .image-content {
        transform: scale(1.05);
        transition: transform 0.3s ease-out, opacity 0.5s ease-out;
    }
</style>

