---
import { Icon } from "astro-icon/components";
import { getPostUrlBySlug } from "@utils/url-utils";

interface Props {
	posts?: { id: string; title: string }[];
}

const { posts = [] } = Astro.props;
---

{posts.length > 0 && (
	<section class="card-base px-6 md:px-9 py-6 mb-6">
		<h2 class="font-bold text-lg text-90 mb-3">相关文章</h2>
		<div class="flex flex-col gap-1">
			{posts.map((post) => (
				<a
					href={getPostUrlBySlug(post.id)}
					class="group flex items-center gap-2 rounded-lg px-3 py-2 text-75 hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] transition-colors"
				>
					<Icon
						name="material-symbols:article-outline-rounded"
						class="shrink-0 text-[1.1rem] opacity-70"
					/>
					<span class="min-w-0 flex-1 truncate">{post.title}</span>
					<Icon
						name="material-symbols:chevron-right-rounded"
						class="shrink-0 text-[1.25rem] opacity-0 transition-opacity group-hover:opacity-70"
					/>
				</a>
			))}
		</div>
	</section>
)}
