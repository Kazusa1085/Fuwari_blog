---
import "../styles/global.css";
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/scrollbar.css";
import "../styles/transition.css";

import { googleAnalyticsConfig, profileConfig, siteConfig } from "@/config";
import ConfigCarrier from "@components/ConfigCarrier.astro";
import FloatingControls from "@components/FloatingControls.svelte";
import ReadingProgressMobile from "@components/ReadingProgressMobile.svelte";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { Font } from "astro:assets";
import { url, pathsEqual } from "../utils/url-utils";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	/** Render a slim page shell for 404s: no decorative islands, no scroll UI. */
	minimal?: boolean;
}

let {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	minimal = false,
} = Astro.props;

// A relative cover path cannot be resolved here (it is handled by
// ImageWrapper at build time), so fall back to the default OG image instead of
// pointing at the site root.
const isRelativeCover =
	typeof banner === "string" &&
	!banner.startsWith("http") &&
	!banner.startsWith("/");
const ogImage =
	banner && banner.trim() !== "" && !isRelativeCover
		? new URL(banner, Astro.site).href
		: new URL("/og.png", Astro.site).href;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
// The theme currently always uses the site banner; keep the prop only for
// OG/description purposes (see ogImage above).
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	if (siteConfig.subtitle && siteConfig.subtitle.trim() !== "") {
		pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
	} else {
		pageTitle = siteConfig.title;
	}
}

// Use siteConfig.description as fallback for meta description when no description is provided
if (!description) {
	description = siteConfig.description || pageTitle;
}

const metaKeywords = siteConfig.keywords ?? [];
const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]"
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />

		{siteConfig.googleSiteVerification && (
			<meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
		)}
		<meta name="msvalidate.01" content="C5E85CB566F21B038B5CF48F91310F09" />
		<meta name="description" content={description}>
		<meta name="author" content={profileConfig.name}>
		{metaKeywords.length > 0 && (
			<meta name="keywords" content={metaKeywords.join(", ")}>
		)}
		<meta name="theme-color" content="#f4f4f4" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)">

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:locale" content={siteConfig.lang.replace("_", "-")}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<link rel="canonical" href={Astro.url} />

		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description}>
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && <meta property="og:image:alt" content={pageTitle} />}
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		{ogImage && <meta name="twitter:image:alt" content={pageTitle} />}

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-roboto" preload={[{ weight: 400 }]} />
		<Font cssVariable="--font-jetbrains-mono" />
		<link rel="preconnect" href="https://www.loliapi.com" />
		<link rel="preconnect" href="https://img.micostar.cc" crossorigin />
		<link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />
		<link rel="dns-prefetch" href="https://umami.raana.icu" />
		<link rel="dns-prefetch" href="https://giscus.app" />
		<script>
			import { exposeUmamiGlobals } from "@/scripts/umami-client";
			exposeUmamiGlobals();
		</script>
		
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue, forceDarkMode: siteConfig.themeColor.forceDarkMode}}>
			// Force dark mode if configured
			if (forceDarkMode) {
				document.documentElement.classList.add('dark');
				localStorage.setItem('theme', DARK_MODE);
			} else {
				// Load the theme from local storage
				const theme = localStorage.getItem('theme') || DEFAULT_THEME;
				switch (theme) {
					case LIGHT_MODE:
						document.documentElement.classList.remove('dark');
						break
					case DARK_MODE:
						document.documentElement.classList.add('dark');
						break
					case AUTO_MODE:
						if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
							document.documentElement.classList.add('dark');
						} else {
							document.documentElement.classList.remove('dark');
						}
				}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);

			// Background image loading detection with mobile support and fallback
			const bgUrl = getComputedStyle(document.documentElement).getPropertyValue('--bg-url').trim();
			const bgEnable = getComputedStyle(document.documentElement).getPropertyValue('--bg-enable').trim();
			
			//console.log('[BG Debug] URL:', bgUrl, 'Enable:', bgEnable);
			
			if (bgUrl && bgUrl !== 'none' && bgEnable === '1') {
				const urlMatch = bgUrl.match(/url\(["']?([^"')]+)["']?\)/);
				//console.log('[BG Debug] URL Match:', urlMatch);
				
				if (urlMatch) {
					let imageUrl = urlMatch[1];
					//console.log('[BG Debug] Loading:', imageUrl);
					
					const img = new Image();
					// 注意：移除 crossOrigin 属性，CSS 背景图不需要 CORS
					// img.crossOrigin = 'anonymous'; // 暂时禁用，简化调试
					
					img.onload = function() {
						//console.log('[BG Debug] Image loaded successfully');
						document.body.classList.add('bg-loaded');
						document.documentElement.style.setProperty('--card-bg', 'var(--card-bg-transparent)');
						document.documentElement.style.setProperty('--float-panel-bg', 'var(--float-panel-bg-transparent)');
					};
					
					img.onerror = function(e) {
						// 加载失败时直接显示背景（暂时禁用备用图床，等待 CORS 修复验证后再启用）
						console.warn('[BG Debug] Image load failed, showing anyway:', e);
						document.body.classList.add('bg-loaded');
					};
					
					img.src = imageUrl;
					
					// 超时保护:5秒后强制显示
					setTimeout(function() {
						if (!document.body.classList.contains('bg-loaded')) {
							console.warn('[BG Debug] Timeout, forcing display');
							document.body.classList.add('bg-loaded');
						}
					}, 5000);
				}
			}
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
			'bg-url': siteConfig.background.src ? `url(${siteConfig.background.src})` : 'none',
			'bg-enable': siteConfig.background.enable ? '1' : '0',
			'bg-position': siteConfig.background.position || 'center',
			'bg-size': siteConfig.background.size || 'cover',
			'bg-repeat': siteConfig.background.repeat || 'no-repeat',
			'bg-attachment': siteConfig.background.attachment || 'fixed',
			'bg-opacity': (siteConfig.background.opacity || 0.3).toString()
		}}>
			:root {
				--bg-url: var(--bg-url);
				--bg-enable: var(--bg-enable);
				--bg-position: var(--bg-position);
				--bg-size: var(--bg-size);
				--bg-repeat: var(--bg-repeat);
				--bg-attachment: var(--bg-attachment);
				--bg-opacity: var(--bg-opacity);
			}
			
			/* Background image configuration */
			body {
				--bg-url: var(--bg-url);
				--bg-enable: var(--bg-enable);
				--bg-position: var(--bg-position);
				--bg-size: var(--bg-size);
				--bg-repeat: var(--bg-repeat);
				--bg-attachment: var(--bg-attachment);
				--bg-opacity: var(--bg-opacity);
			}
			
			body::before {
				content: '' !important;
				position: fixed !important;
				top: 0 !important;
				left: 0 !important;
				right: 0 !important;
				bottom: 0 !important;
				width: 100vw !important;
				height: 100vh !important;
				/* iOS Safari 需要明确的高度 */
				min-height: 100vh !important;
				min-height: -webkit-fill-available !important;
				background-image: var(--bg-url) !important;
				background-position: var(--bg-position) !important;
				background-size: var(--bg-size) !important;
				background-repeat: var(--bg-repeat) !important;
				opacity: 0 !important;
				pointer-events: none !important;
				z-index: -1 !important;
				display: block !important;
				transition: opacity 0.3s ease-in-out !important;
				/* iOS Safari 优化 */
				will-change: opacity !important;
				-webkit-backface-visibility: hidden !important;
				backface-visibility: hidden !important;
				transform: translate3d(0, 0, 0) !important;
				-webkit-transform: translate3d(0, 0, 0) !important;
			}
			
			body.bg-loaded::before {
				opacity: var(--bg-opacity) !important;
			}
			
			/* iOS Safari 特殊处理：强制 fixed 定位 */
			@supports (-webkit-touch-callout: none) {
				body::before {
					/* 保持 fixed 但确保渲染 */
					position: fixed !important;
					/* 使用 inset 简写 */
					inset: 0 !important;
					/* iOS 需要明确的 overflow */
					overflow: hidden !important;
				}
				
				html {
					/* 防止 body 滚动时背景消失 */
					overflow-x: hidden;
				}
				
				body {
					/* 确保 body 可以滚动 */
					position: relative;
					min-height: 100vh;
				}
			}
			
		/* Mobile & Tablet fallback: 2秒后自动显示（扩大到 1024px 支持 iPad） */
		@media (max-width: 1024px) {
			body::before {
				animation: mobile-bg-fallback 0.5s ease 2s forwards !important;
			}
		}
		
		/* 触摸屏设备通用 fallback（兼容所有 iPad 和平板） */
		@media (hover: none) and (pointer: coarse) {
			body::before {
				animation: mobile-bg-fallback 0.5s ease 2s forwards !important;
			}
		}			@keyframes mobile-bg-fallback {
				to {
					opacity: var(--bg-opacity) !important;
				}
			}
		</style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->

		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>
		<!-- Umami 分析（与分享区域保持一致 cloud.umami.is） -->
		<script defer src="https://umami.raana.icu/script.js" data-website-id="28af012a-b635-4011-bcd5-b08ee8b1a2f8"></script>
		<!-- Umami 分享数据辅助脚本（缓存 share token / websiteId） -->

		<!-- Google Analytics: 由 Cookie 同意组件动态加载 -->

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
	>
		{!minimal && <div id="antigravity-bg" class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none" aria-hidden="true"></div>}
		<script>
			// The particle background is decorative: skip mobile, save-data and
			// reduced-motion visitors, then load three.js on idle so it never
			// competes with first paint / LCP.
			const antigravityHost = document.getElementById("antigravity-bg");
			const antigravityAllowed =
				antigravityHost &&
				window.innerWidth >= 768 &&
				!window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
				!((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
			if (antigravityAllowed) {
				let started = false;
				const start = () => {
					if (started || !antigravityHost) return;
					started = true;
					import("../scripts/antigravity-bg")
						.then(({ startAntigravityBackground }) => startAntigravityBackground(antigravityHost))
						.catch(() => {});
				};
				const schedule = () => {
					if ("requestIdleCallback" in window) {
						window.requestIdleCallback(start, { timeout: 2500 });
					} else {
						setTimeout(start, 1200);
					}
				};
				if (document.readyState === "complete") schedule();
				else window.addEventListener("load", schedule, { once: true });
			}
		</script>
		<ConfigCarrier></ConfigCarrier>
		{!minimal && <FloatingControls client:only="svelte" />}
		{!minimal && <ReadingProgressMobile client:only="svelte" />}
		<script>
			import { antiLeechConfig } from "@/config";
			import { initDomainWarning } from "@/scripts/domain-warning";
			initDomainWarning(antiLeechConfig);
		</script>
		<div id="main-content-wrapper">
			<slot />
		</div>

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>





		<!-- Cookie 同意弹窗 -->
		<style>
			#cookie-consent-banner{position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;width:340px;max-width:calc(100vw - 2rem);background:var(--card-bg,rgba(35,38,48,0.95));border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:20px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 8px 32px rgba(0,0,0,0.3);transform-origin:bottom right;transform:scale(0);opacity:0;transition:transform .35s cubic-bezier(.34,1.56,.64,1),opacity .25s ease;}
			#cookie-consent-banner.cc-show{transform:scale(1);opacity:1;}
			#cookie-consent-banner.cc-hide{animation:cc-shrink .8s cubic-bezier(.4,0,.2,1) forwards;}
		@keyframes cc-shrink{0%{transform:scale(1);opacity:1;}30%{transform:scale(1.04);opacity:1;}100%{transform:scale(0);opacity:0;}}
			.cc-title{font-size:15px;font-weight:700;color:var(--text-color,#eee);margin-bottom:10px;}
			.cc-desc{font-size:12px;line-height:1.6;color:var(--text-color,#ccc);opacity:.85;margin-bottom:14px;}
			.cc-desc a{color:var(--primary,#a78bfa);text-decoration:underline;}
			.cc-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
			.cc-always{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--text-color,#ccc);cursor:pointer;user-select:none;margin-right:auto;}
			.cc-always input{accent-color:var(--primary,#a78bfa);cursor:pointer;}
			.cc-btn{padding:6px 16px;border-radius:8px;font-size:12px;cursor:pointer;font-weight:600;border:none;transition:opacity .2s;}
			.cc-btn:hover{opacity:.85;}
			.cc-btn-no{background:transparent;border:1px solid rgba(255,255,255,0.2);color:var(--text-color,#ccc);}
			.cc-btn-yes{background:var(--primary,#a78bfa);color:#fff;}
		</style>
		<div id="cookie-consent-banner">
			<div class="cc-title">🍪 Cookie</div>
			<div class="cc-desc">本站使用 Cookie 及第三方服务（Google Analytics）改善浏览体验。Umami 统计不使用 Cookie，始终运行。<br/>This site uses cookies and third-party services (Google Analytics). Umami analytics is cookie-free and always active.<br/><a href="/about-privacy/">隐私政策 / Privacy Policy</a></div>
			<div class="cc-actions">
				<label class="cc-always"><input type="checkbox" id="cc-always" />始终记住 Always</label>
				<button class="cc-btn cc-btn-yes" id="cookie-accept">同意 Yes</button>
				<button class="cc-btn cc-btn-no" id="cookie-reject">拒绝 No</button>
			</div>
		</div>
		<script is:inline define:vars={{ googleAnalyticsConfig }}>
		(function(){
			var CK='cookie-consent',cs=localStorage.getItem(CK);
			function loadGA(){
				if(!googleAnalyticsConfig.enable)return;
				var s=document.createElement('script');
				s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+googleAnalyticsConfig.measurementId;
				document.head.appendChild(s);
				s.onload=function(){window.dataLayer=window.dataLayer||[];function g(){dataLayer.push(arguments);}g('js',new Date());g('config',googleAnalyticsConfig.measurementId);};
			}
			function loadAll(){loadGA();}
			if(cs==='always-accepted'){loadAll();return;}
			if(cs==='accepted')loadAll();
			if(cs==='always-rejected')return;
			var b=document.getElementById('cookie-consent-banner');
			function hide(){b.classList.remove('cc-show');b.classList.add('cc-hide');}
			setTimeout(function(){b.style.display='block';requestAnimationFrame(function(){b.classList.add('cc-show');});},600);
			document.getElementById('cookie-accept').onclick=function(){
				var a=document.getElementById('cc-always').checked;
				localStorage.setItem(CK,a?'always-accepted':'accepted');
				hide();if(cs!=='accepted')loadAll();
			};
			document.getElementById('cookie-reject').onclick=function(){
				var a=document.getElementById('cc-always').checked;
				localStorage.setItem(CK,a?'always-rejected':'rejected');
				hide();
			};
		})();
		</script>

	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@reference "../styles/global.css";

@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}
</style>

<script>
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";
import {pathsEqual, url} from "../utils/url-utils";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT
} from "../constants/constants";
import { siteConfig } from '../config';


const bannerEnabled = !!document.getElementById('banner-wrapper')

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		if (!panelDom) return;
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}



function showBanner() {
	if (!siteConfig.banner.enable) return;
	
	const banner = document.getElementById('banner');
	if (!banner) {
		console.error('Banner element not found');
		return;
	}
	
	banner.classList.remove('opacity-0', 'scale-105');
}

function scrollToContentOnMobile() {
	if (window.innerWidth < 1024) {
		const target = document.getElementById('swup-container')
		if (target) {
			const navbarHeight = 72
			const y = target.getBoundingClientRect().top + window.scrollY - navbarHeight
			window.scrollTo({ top: y, behavior: 'smooth' })
		}
	}
}

function init() {
	loadTheme();
	loadHue();
	showBanner();
	setTimeout(scrollToContentOnMobile, 350)
}

/* Load settings when entering the site */
init();

const setup = () => {
	// TODO: temp solution to change the height of the banner
	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')

		// prevent elements from overlapping the navbar
		if (!bannerEnabled) {
			return
		}
		let threshold = window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16
		let navbar = document.getElementById('navbar-wrapper')
		if (!navbar || !document.body.classList.contains('lg:is-home')) {
			return
		}
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		}
	})
	window.swup.hooks.on('visit:start', (visit: {to: {url: string}, scroll: {reset: boolean}}) => {
		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		if (pathsEqual(visit.to.url, url('/'))) {
			bodyElement!.classList.add('lg:is-home');
		} else {
			bodyElement!.classList.remove('lg:is-home');
		}

		// 移动端：阻止 Swup ScrollPlugin 自动滚回顶部，由 scrollToContentOnMobile 接管
		if (window.innerWidth < 1024) {
			visit.scroll.reset = false
		}

		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}
	});
	window.swup.hooks.on('page:view', () => {
		// hide the temp high element when the transition is done
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}
	});
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		setTimeout(() => {
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.add('hidden')
			}

            // Just make the transition looks better
            const toc = document.getElementById('toc-wrapper');
            if (toc) {
                toc.classList.remove('toc-not-ready')
            }

            // 移动端文章页：自动滚动到文章内容区域，跳过 sidebar（个人信息/标签）
            scrollToContentOnMobile()
        }, 200)
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

let backToTopBtn = document.getElementById('back-to-top-btn');
let toc = document.getElementById('toc-wrapper');
let navbar = document.getElementById('navbar-wrapper')
// 优化 scrollPerformance：使用 requestAnimationFrame 防抖
function scrollFunction() {
	let bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100)

	if (backToTopBtn) {
		if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			backToTopBtn.classList.remove('hide')
		} else {
			backToTopBtn.classList.add('hide')
		}
	}

	if (bannerEnabled && toc) {
		if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			toc.classList.remove('toc-hide')
		} else {
			toc.classList.add('toc-hide')
		}
	}

	if (!bannerEnabled) return
	if (navbar) {
		const NAVBAR_HEIGHT = 72
		const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16			// The height the main panel overlaps the banner

		let bannerHeight = BANNER_HEIGHT
		if (document.body.classList.contains('lg:is-home') && window.innerWidth >= 1024) {
			bannerHeight = BANNER_HEIGHT_HOME
		}
		let threshold = window.innerHeight * (bannerHeight / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		} else {
			navbar.classList.remove('navbar-hidden')
		}
	}
}
let scrollTicking = false;
function onScrollRaf() {
	if (scrollTicking) return;
	scrollTicking = true;
	requestAnimationFrame(() => {
		scrollFunction();
		scrollTicking = false;
	});
}
window.addEventListener("scroll", onScrollRaf, { passive: true });

window.addEventListener("resize", () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}, { passive: true });

</script>

<script>
// Image lightbox: PhotoSwipe (MIT). JS + CSS are loaded only on first
// intent (pointer over an image, or a click), so a normal page view costs
// nothing and the library still works across Swup visits.
import photoswipeCssUrl from "photoswipe/style.css?url";

const PSWP_SELECTOR = ".custom-md img, #post-cover img";
let photoswipeModule: Promise<any> | null = null;
let photoswipeCssInjected = false;

const injectPhotoSwipeCss = () => {
	if (photoswipeCssInjected || document.querySelector("link[data-pswp-css]")) return;
	photoswipeCssInjected = true;
	const link = document.createElement("link");
	link.rel = "stylesheet";
	link.href = photoswipeCssUrl;
	link.dataset.pswpCss = "1";
	document.head.appendChild(link);
};

const loadPhotoSwipe = () => {
	if (!photoswipeModule) {
		injectPhotoSwipeCss();
		photoswipeModule = import("photoswipe").then((mod) => mod.default ?? mod);
	}
	return photoswipeModule;
};

const openPhotoSwipe = async (clicked: HTMLImageElement) => {
	const PhotoSwipe = await loadPhotoSwipe();
	const images = Array.from(
		document.querySelectorAll<HTMLImageElement>(PSWP_SELECTOR),
	).filter((img) => Boolean(img.currentSrc || img.src));
	if (images.length === 0) return;
	const items = images.map((img) => ({
		src: img.currentSrc || img.src,
		width: img.naturalWidth || 1600,
		height: img.naturalHeight || 900,
		alt: img.alt || "",
	}));
	const gallery = new PhotoSwipe({
		dataSource: items,
		index: Math.max(0, images.indexOf(clicked)),
		bgOpacity: 0.92,
		showHideAnimationType: "fade",
		wheelToZoom: true,
	});
	gallery.init();
};

const onLightboxClick = (event: MouseEvent) => {
	const target = event.target;
	if (!(target instanceof Element)) return;
	const image = target.closest(PSWP_SELECTOR) as HTMLImageElement | null;
	if (!image) return;
	event.preventDefault();
	void openPhotoSwipe(image);
};
document.addEventListener("click", onLightboxClick);

let photoswipePrefetched = false;
const prefetchPhotoSwipe = (event: Event) => {
	if (photoswipePrefetched) return;
	const target = event.target;
	if (!(target instanceof Element)) return;
	if (!target.closest(PSWP_SELECTOR)) return;
	photoswipePrefetched = true;
	void loadPhotoSwipe();
};
document.addEventListener("pointerover", prefetchPhotoSwipe, { passive: true });
document.addEventListener("touchstart", prefetchPhotoSwipe, { passive: true });
</script>
