---
import Layout from "@layouts/Layout.astro";
import { url } from "@utils/url-utils";
---

<Layout title="页面走丢了" description="你访问的页面不存在，可能已经被移动或删除。" minimal>
    <main class="min-h-screen flex flex-col items-center justify-center text-center px-6 py-16">
        <p class="text-sm font-mono text-black/40 dark:text-white/40 mb-2">404</p>
        <h1 class="text-5xl md:text-6xl font-bold text-black/90 dark:text-white/90 mb-4">这里什么都没有喵~</h1>
        <p class="max-w-md text-black/50 dark:text-white/50 mb-8">
            你访问的页面不存在，可能已经被移动、删除，或者链接本身就打错了。
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
            <a href={url("/")} class="btn-card rounded-xl h-11 px-6 flex items-center gap-2 font-bold text-[var(--primary)]">返回首页</a>
            <a href={url("/archive/")} class="btn-card rounded-xl h-11 px-6 flex items-center gap-2 font-bold text-black/70 dark:text-white/70">查看文章归档</a>
        </div>
    </main>
</Layout>
