# 复制这个文件为 .env，按需修改
#
# ============================================
# 内容分离配置
# ============================================
# 文章 (content/posts)、友链 (content/friends)、项目 (content/projects)
# 从独立仓库 Kazusa1085/Blog_Archive 同步到本地的 content/ 目录。

# 是否启用内容分离，从独立仓库同步 content/ 目录 (true/false)
ENABLE_CONTENT_SYNC=true

# 内容仓库的 Git 地址
CONTENT_REPO_URL=https://github.com/Kazusa1085/Blog_Archive.git

# 内容目录路径（相对于项目根目录），一般不需要改动
# CONTENT_DIR=content

# ============================================
# Albireo PoW 防爬（Vercel Middleware）
# ============================================
# 部署到 Vercel 时请在项目设置里的 Environment Variables 配置 ALBIREO_SECRET。
# 可使用 `openssl rand -hex 32` 等工具生成一个足够长的随机字符串。

# 总开关：设 false 可以完全关闭 PoW 防爬，中间件直接放行（默认开启）
# ALBIREO_ENABLED=true

# 签名 cookie 用的密钥（必填）
ALBIREO_SECRET=

# PoW 难度：连续前导 0 的个数，越大越慢，建议 3~6
# ALBIREO_DIFFICULTY=4

# Challenge 有效期（毫秒），默认 5 分钟
# ALBIREO_CHALLENGE_TTL=300000

# 通过后 cookie 的有效期（毫秒），默认 24 小时
# ALBIREO_SOLVED_TTL=86400000
